{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "opencode-custom",
  "disabled_agents": ["observer"],
  "presets": {
    "opencode-custom": {
      "orchestrator": {
        "model": [
          { "id": "opencode-go/glm-5.3-flash", "variant": "high" },
          { "id": "opencode-go/deepseek-v4-pro", "variant": "high" }
        ],
        "skills": [
          "*"
        ],
        "mcps": [
          "*",
          "!context7"
        ]
      },
      "oracle": {
        "model": [
          { "id": "opencode-go/deepseek-v4-pro", "variant": "high" },
          { "id": "opencode-go/gpt-5.6-luna", "variant": "high" }
        ],
        "skills": [
          "simplify"
        ],
        "mcps": []
      },
      "explorer": {
        "model": [
          { "id": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
          { "id": "opencode-go/muse-spark-1.3-contributor", "variant": "high" }
        ],
        "skills": [],
        "mcps": []
      },
      "librarian": {
        "model": [
          { "id": "opencode-go/muse-spark-1.3-contributor", "variant": "high" },
          { "id": "opencode-go/glm-5.3-flash", "variant": "high" }
        ],
        "skills": [],
        "mcps": [
          "context7",
          "gh_grep"
        ]
      },
      "designer": {
        "model": [
          { "id": "opencode-go/glm-5.3-flash", "variant": "high" },
          { "id": "opencode-go/gpt-5.6-luna", "variant": "high" }
        ],
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": [
          { "id": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
          { "id": "opencode-go/qwen3.8-flash", "variant": "medium" }
        ],
        "skills": [],
        "mcps": []
      },
      "observer": {
        "model": [
          { "id": "opencode-go/glm-5.3-flash", "variant": "high" },
          "opencode-go/mimo-v2.5"
        ],
        "skills": [],
        "mcps": []
      },
      "council": {
        "model": [
          { "id": "opencode-go/gpt-5.6-luna", "variant": "max" }
        ]
      }
    }
  },
  "council": {
    "presets": {
      "default": {
        "alpha": {
          "model": "opencode-go/deepseek-v4-pro"
        },
        "beta": {
          "model": "opencode-go/glm-5.3-flash"
        },
        "gamma": {
          "model": "opencode-go/muse-spark-1.3-contributor"
        }
      }
    }
  },
  "agents": {
    "handyman": {
      "model": [
        "opencode-go/mimo-v2.5",
        { "id": "opencode-go/deepseek-v4-flash", "variant": "low" }
      ],
      "skills": [],
      "mcps": [],
      "prompt": "You are Handyman, a fast utility specialist for mechanical shell/ops tasks. Your domain is bash-centric work: git commits, linting, code formatting, running project scripts, test suites, and small file operations. You do not edit code logic or architecture — that is for the Fixer. Work quickly and return concise, actionable results.",
      "orchestratorPrompt": "@handyman\n- Lane: Fast utility worker for shell/ops and mechanical tasks\n- Role: Handles git commits, linting, formatting, running scripts, test suites, and small file operations\n- **Delegate when:** User asks to commit changes • linting or formatting code • running test suites • executing project scripts • bulk file operations (renames, cleanup) • checking build status\n- **Don't delegate when:** Code logic changes or implementation • architectural decisions • research or documentation lookup • UI/UX work\n- **Rule of thumb:** Bash-centric mechanical task? → @handyman. Code editing? → @fixer."
    }
  }
}

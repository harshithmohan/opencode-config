{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git checkout --*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch -D *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git rebase *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git filter-branch *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git -C *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rmdir *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "shred *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "mv *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "find * -delete*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "find * -exec*",
      "effect": "ask"
    }
  ],
  "websearch": {
    "provider": "exa"
  },
  "plugins": [
    "@hadronomy/opencode-handoff-plugin",
    "billion-context",
    "@slkiser/opencode-quota",
    "oh-my-opencode-slim"
  ],
  "compaction": {
    "auto": false
  },
  "lsp": true,
  "formatter": true,
  "shell": "/bin/bash",
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  }
}

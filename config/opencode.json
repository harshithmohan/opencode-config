{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "openrouter",
    "anthropic"
  ],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "allow",
      "git commit": "ask",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git reset": "ask",
      "git reset *": "ask",
      "git clean": "ask",
      "git clean *": "ask",
      "git checkout --*": "ask",
      "git branch -D": "ask",
      "git branch -D *": "ask",
      "git rebase": "ask",
      "git rebase *": "ask",
      "git filter-branch": "ask",
      "git filter-branch *": "ask",
      "git -C *": "deny",
      "rm *": "ask",
      "rmdir *": "ask",
      "shred *": "ask",
      "mv *": "ask",
      "find * -delete*": "ask",
      "find * -exec*": "ask"
    }
  },
  "plugin": [
    "opencode-acp",
    "opencode-handoff",
    "oh-my-opencode-slim"
  ],
  "compaction": {
    "auto": false
  },
  "lsp": true,
  "formatter": true,
  "shell": "/bin/bash",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
